"rst-control-fw\stm32f1xx_hal_uart.o"
"rst-control-fw\system_stm32f1xx.o"
--strict --scatter "rst-control-fw\rst-control-fw.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "rst-control-fw.map" -o rst-control-fw\rst-control-fw.axf