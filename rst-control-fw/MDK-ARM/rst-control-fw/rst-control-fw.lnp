--cpu Cortex-M3
"rst-control-fw\startup_stm32f103xe.o"
"rst-control-fw\main.o"
"rst-control-fw\gpio.o"
"rst-control-fw\adc.o"
"rst-control-fw\can.o"
"rst-control-fw\dma.o"
"rst-control-fw\tim.o"
"rst-control-fw\usart.o"
"rst-control-fw\stm32f1xx_it.o"
"rst-control-fw\stm32f1xx_hal_msp.o"
"rst-control-fw\debug_console.o"
"rst-control-fw\motor_driver.o"
"rst-control-fw\stm32f1xx_hal_gpio_ex.o"
"rst-control-fw\stm32f1xx_hal_adc.o"
"rst-control-fw\stm32f1xx_hal_adc_ex.o"
"rst-control-fw\stm32f1xx_hal.o"
"rst-control-fw\stm32f1xx_hal_rcc.o"
"rst-control-fw\stm32f1xx_hal_rcc_ex.o"
"rst-control-fw\stm32f1xx_hal_gpio.o"
"rst-control-fw\stm32f1xx_hal_dma.o"
"rst-control-fw\stm32f1xx_hal_cortex.o"
"rst-control-fw\stm32f1xx_hal_pwr.o"
"rst-control-fw\stm32f1xx_hal_flash.o"
"rst-control-fw\stm32f1xx_hal_flash_ex.o"
"rst-control-fw\stm32f1xx_hal_exti.o"
"rst-control-fw\stm32f1xx_hal_can.o"
"rst-control-fw\stm32f1xx_hal_tim.o"
